<h1>Earning for <%= @employee.proper_name %></h1>

<p><strong>Period:</strong>
<p>
  <%= @start_date.strftime("%-m/%-d/%y") %> -
  <%= @end_date.strftime("%-m/%-d/%y") %>
</p>

<p><strong><%= @employee.name %></strong></p>

<p><strong>SSN:</strong> <%= @employee.ssn %></p>

<p><strong>Pay Grade:</strong>
<%= @employee.current_assignment&.pay_grade&.level %>
</p>

<p><strong>Pay Rate:</strong>
$<%= sprintf("%.2f", @employee.current_assignment&.pay_grade&.current_rate&.rate || 0) %>
</p>

<p><strong>Hours Worked:</strong>
<%= @employee_payroll.sum(&:duration) %>
</p>

<p><strong>Earnings:</strong>
$<%= sprintf("%.2f",
  @employee_payroll.sum(&:duration) *
  (@employee.current_assignment&.pay_grade&.current_rate&.rate || 0)
) %>
</p>

<%= link_to "Back", employee_form_path, class: "btn btn-secondary" %>