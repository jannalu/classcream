<h1>Employee Payroll</h1>

<%= form_tag employee_payroll_path, method: :get, local: true do %>
  <div class="cc-form-group">
    <%= label_tag :employee_id, "Employee", class: "cc-label" %>
    <%= select_tag :employee_id, options_from_collection_for_select(Employee.active.alphabetical, :id, :name), include_blank: "Select Employee", class: "form-select" %>
  </div>
  <div class="cc-form-group">
    <%= label_tag :start_date, "Start Date", class: "cc-label" %>
    <%= date_field_tag :start_date, Date.today.to_s, class: "cc-input" %>
  </div>
  <div class="cc-form-group">
    <%= label_tag :end_date, "End Date", class: "cc-label" %>
    <%= date_field_tag :end_date, Date.today.to_s, class: "cc-input" %>
  </div>
  <%= submit_tag "Generate Report", class: "btn-cc" %>
<% end %>