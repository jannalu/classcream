<h2>Login</h2>

<%= form_tag sessions_path, method: :post do %>
  <div>
    <%= label_tag :username, "Username" %>
    <%= text_field_tag :username %>
  </div>
  <div>
    <%= label_tag :password, "Password" %>
    <%= password_field_tag :password %>
  </div>
  <%= submit_tag "Log In" %>
<% end %>

<% if flash[:error] %>
  <p><%= flash[:error] %></p>
<% end %>