<div id="topbar">
  <div class="container d-flex align-items-center gap-3">
    <%= link_to home_path do %>
      <%= image_tag 'classic_creamery_logo_small.png', class: 'topbar-logo', alt: 'Classic Creamery' %>
    <% end %>
    <div>
      <h2><%= link_to 'Classic Creamery', home_path %></h2>
      <p class="topbar-tagline"><em>Old fashion ice cream made the old fashion way</em></p>
    </div>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Fredoka+One&display=swap');

  #topbar {
    background: #fff9fe;
    padding: 0.85rem 0;
    border-bottom: 2px solid #f5d0fe;
    font-family: 'Nunito', sans-serif;
  }

  #topbar h2 {
    margin: 0;
    line-height: 1.2;
  }

  #topbar h2 a {
    font-family: 'Fredoka One', sans-serif;
    font-size: 1.8rem;
    background: linear-gradient(90deg, #ec4899, #a855f7, #6366f1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-decoration: none;
  }

  #topbar h2 a:hover {
    opacity: 0.85;
  }

  .topbar-tagline {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: #c084fc;
  }

  .topbar-logo {
    height: 52px;
    width: auto;
  }
</style>