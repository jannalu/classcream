<nav class="navbar navbar-expand-lg" id="nav">
  <div class="container-fluid px-4">
    <a class="navbar-brand" href="/">
      <img src="/assets/classic_creamery_logo.png" alt="Classic Creamery" height="40" />
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">
        <% if current_user&.admin_role? || current_user&.manager_role? %>
          <li class="nav-item">
            <%= link_to 'Stores', stores_path, class: "nav-link #{'active' if current_page?(stores_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to 'Employees', employees_path, class: "nav-link #{'active' if current_page?(employees_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to 'Assignments', assignments_path, class: "nav-link #{'active' if current_page?(assignments_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to 'Shifts', shifts_path, class: "nav-link #{'active' if current_page?(shifts_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to 'Jobs', jobs_path, class: "nav-link #{'active' if current_page?(jobs_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to 'Pay Grades', pay_grades_path, class: "nav-link #{'active' if current_page?(pay_grades_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to 'Employee Payroll', employee_form_path, class: "nav-link #{'active' if current_page?(employee_form_path)}" %>
          </li>
        <% end %>
      </ul>

      <ul class="navbar-nav">
        <li class="nav-item">
          <% if logged_in? %>
            <%= link_to 'Logout', logout_path, class: "nav-link logout-btn" %>
          <% else %>
            <%= link_to 'Login', login_path, class: "nav-link logout-btn" %>
          <% end %>
        </li>
      </ul>
