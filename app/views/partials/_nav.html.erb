</nav>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Fredoka+One&display=swap');

  #nav {
    background: linear-gradient(90deg, #ff8dc7 0%, #c084fc 50%, #818cf8 100%);
    border-bottom: 2px solid rgba(255, 255, 255, 0.2);
    padding: 0.35rem 0;
    font-family: 'Nunito', sans-serif;
    position: relative;
  }

  /* subtle sparkle dots */
  #nav::after {
    content: '✦  ✦  ✦';
    position: absolute;
    right: 160px;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.2);
    font-size: 10px;
    letter-spacing: 6px;
    pointer-events: none;
  }

  #nav .navbar-brand img {
    filter: brightness(0) invert(1);
    drop-shadow: 0 0 6px rgba(255,255,255,0.4);
  }

  #nav .nav-link {
    color: rgba(255, 255, 255, 0.85) !important;
    font-size: 14px;
    font-weight: 700;
    padding: 0.5rem 0.9rem !important;
    position: relative;
    transition: color 0.15s ease, background 0.15s ease;  /* add background */
    text-decoration: none;
    border-radius: 10px;                                   /* add this */
  }

  #nav .nav-link:hover {
  color: #ffffff !important;
  background: rgba(255, 255, 255, 0.2);                 /* add this */
}

  #nav .nav-link.active {
    color: #ffffff !important;
  }

  #nav .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0.9rem;
    right: 0.9rem;
    height: 2.5px;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 2px;
  }

  #nav .logout-btn {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff !important;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    border-radius: 50px;
    padding: 0.4rem 1.2rem !important;
    font-size: 14px;
    font-weight: 800;
    transition: background 0.15s ease;
    backdrop-filter: blur(4px);
  }

  #nav .logout-btn:hover {
    background: rgba(255, 255, 255, 0.38);
    color: #ffffff !important;
  }

  #nav .logout-btn::after {
    display: none;
  }

  #nav .navbar-toggler {
    border-color: rgba(255, 255, 255, 0.4);
  }

  #nav .navbar-toggler-icon {
    filter: invert(1);
  }
</style>
