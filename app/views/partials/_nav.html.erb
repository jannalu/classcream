<nav class="navbar navbar-expand-lg" id="nav">
  <div class="container-fluid px-4">
    <a class="navbar-brand" href="/">
      <img src="/assets/classic_creamery_logo.png" alt="Classic Creamery" height="40" />
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">
        <% if current_user&.admin_role? || current_user&.manager_role? %>
          <li class="nav-item">
            <%= link_to 'Stores', stores_path, class: "nav-link #{'active' if current_page?(stores_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to 'Employees', employees_path, class: "nav-link #{'active' if current_page?(employees_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to 'Assignments', assignments_path, class: "nav-link #{'active' if current_page?(assignments_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to 'Shifts', shifts_path, class: "nav-link #{'active' if current_page?(shifts_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to 'Jobs', jobs_path, class: "nav-link #{'active' if current_page?(jobs_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to 'Pay Grades', pay_grades_path, class: "nav-link #{'active' if current_page?(pay_grades_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to 'Employee Payroll', employee_form_path, class: "nav-link #{'active' if current_page?(employee_form_path)}" %>
          </li>
        <% end %>
      </ul>

      <ul class="navbar-nav">
        <li class="nav-item">
          <% if logged_in? %>
            <%= link_to 'Logout', logout_path, class: "nav-link logout-btn" %>
          <% else %>
            <%= link_to 'Login', login_path, class: "nav-link logout-btn" %>
          <% end %>
        </li>
      </ul>
    </div>
  </div>
</nav>

<style>
  #nav {
    background-color: #1a2744;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    padding: 0.35rem 0;
  }

  #nav .navbar-brand img {
    filter: brightness(0) invert(1);
  }

  #nav .nav-link {
    color: rgba(255, 255, 255, 0.75) !important;
    font-size: 14px;
    font-weight: 500;
    padding: 0.5rem 0.9rem !important;
    position: relative;
    transition: color 0.15s ease;
    text-decoration: none;
  }

  #nav .nav-link:hover {
    color: #ffffff !important;
  }

  #nav .nav-link.active {
    color: #ffffff !important;
  }

  #nav .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0.9rem;
    right: 0.9rem;
    height: 2px;
    background-color: #e8734a;
    border-radius: 2px;
  }

  #nav .logout-btn {
    background-color: #e8734a;
    color: #ffffff !important;
    border-radius: 50px;
    padding: 0.4rem 1.1rem !important;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.15s ease;
  }

  #nav .logout-btn:hover {
    background-color: #d45e35;
    color: #ffffff !important;
  }

  #nav .logout-btn::after {
    display: none;
  }

  #nav .navbar-toggler {
    border-color: rgba(255,255,255,0.3);
  }

  #nav .navbar-toggler-icon {
    filter: invert(1);
  }
</style>