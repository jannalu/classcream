<footer id="footer">
  <div class="footer-links">
    <%= link_to 'Home',           home_path,    class: "footer-link" %>
    <%= link_to 'About',          about_path,   class: "footer-link" %>
    <%= link_to 'Contact Us',     contact_path, class: "footer-link" %>
    <%= link_to 'Privacy Policy', privacy_path, class: "footer-link" %>
  </div>
  <div class="footer-copy">
    &copy; 2026 &mdash;
    <%= mail_to("profh@cmu.edu", "Klingon Code Warrior", encode: "javascript", class: "footer-email") %>
  </div>
</footer>

<style>
  #footer {
    background: linear-gradient(90deg, #818cf8 0%, #c084fc 50%, #ff8dc7 100%);
    padding: 1.5rem 2rem;
    margin-top: 3rem;
    text-align: center;
    font-family: 'Nunito', sans-serif;
    position: relative;
    overflow: hidden;
  }

  #footer::before {
    content: '';
    position: absolute;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    top: -50px;
    left: -30px;
    pointer-events: none;
  }

  #footer::after {
    content: '';
    position: absolute;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    bottom: -30px;
    right: 60px;
    pointer-events: none;
  }

  .footer-links {
    margin-bottom: 0.6rem;
    position: relative;
    z-index: 1;
  }

  .footer-link {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    margin: 0 12px;
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-copy {
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    font-weight: 600;
    position: relative;
    z-index: 1;
  }

  .footer-email {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    font-weight: 700;
  }

  .footer-email:hover {
    color: #ffffff;
  }
</style>
