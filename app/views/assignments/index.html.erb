
<h1>Current Assignments</h1>

<table class="cc-table">
  <thead class="table-dark">
    <tr>
      <th>Employee</th>
      <th>Store</th>
      <th>Pay Grade</th>
      <th>Start Date</th>
      <th>Shift Count</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @current_assignments.each do |assignment| %>
      <tr>
        <td><%= assignment.employee.proper_name %></td>
        <td><%= assignment.store.name %></td>
        <td><%= assignment.pay_grade.level %></td>
        <td><%= assignment.start_date.strftime("%m/%d/%y") %></td>
        <td><%= assignment.shifts.count %></td>
        <td><%= link_to "View", assignment_path(assignment), class: "btn btn-sm btn-dark" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<h2>Past Assignments</h2>
<table class="cc-table">
  <thead class="table-dark">
    <tr>
      <th>Employee</th>
      <th>Store</th>
      <th>Pay Grade</th>
      <th>Start Date</th>
      <th>End Date</th>
      <th>Shift Count</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @past_assignments.each do |assignment| %>
      <tr>
        <td><%= assignment.employee.proper_name %></td>
        <td><%= assignment.store.name %></td>
        <td><%= assignment.pay_grade.level %></td>
        <td><%= assignment.start_date.strftime("%m/%d/%y") %></td>
        <td><%= assignment.end_date.strftime("%m/%d/%y") %></td>
        <td><%= assignment.shifts.count %></td>
        <td><%= link_to "View", assignment_path(assignment), class: "btn btn-sm btn-dark" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "New Assignment", new_assignment_path, class: "btn-cc mt-3" %>