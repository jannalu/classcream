<% th_style = "color: #fff; font-size: 12px; font-weight: 600; padding: 12px 16px; text-align: left; letter-spacing: 0.05em;" %>
<% td_style = "font-size: 14px; padding: 12px 16px; color: #333;" %>
<% view_btn_style = "background-color: #1a2744; color: #fff; padding: 6px 14px; border-radius: 6px; text-decoration: none; font-size: 13px; font-weight: 500;" %>

<div style="background-color: #f2ede6; min-height: 100vh; padding: 1.5rem;">

  <h1 style="font-size: 1.8rem; font-weight: 600; color: #1a1a1a; margin-bottom: 1.25rem;">
    Active Employees at ClassicCreamery
  </h1>

  <div style="background: #fff; border-radius: 10px; overflow: hidden; margin-bottom: 2rem;">
    <table style="width: 100%; border-collapse: collapse;">
      <thead>
        <tr style="background-color: #1a2744;">
          <th style="<%= th_style %>">Name</th>
          <th style="<%= th_style %>">Phone</th>
          <th style="<%= th_style %>">Current Assignment</th>
          <th style="<%= th_style %>"></th>
        </tr>
      </thead>
      <tbody>
        <% @active_employees.each do |employee| %>
          <tr style="border-bottom: 1px solid #f0ebe3;">
            <td style="<%= td_style %>"><%= employee.name %></td>
            <td style="<%= td_style %>"><%= number_to_phone(employee.phone) %></td>
            <td style="<%= td_style %>">
              <%= employee.current_assignment ? "#{employee.current_assignment.store.name} (#{employee.current_assignment.pay_grade.level})" : "n/a" %>
            </td>
            <td style="<%= td_style %>; text-align: right;">
              <%= link_to "View", employee_path(employee), style: view_btn_style %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <h2 style="font-size: 1.4rem; font-weight: 600; color: #1a1a1a; margin-bottom: 1.25rem;">
    Inactive Employees
  </h2>

  <div style="background: #fff; border-radius: 10px; overflow: hidden; margin-bottom: 2rem;">
    <table style="width: 100%; border-collapse: collapse;">
      <thead>
        <tr style="background-color: #1a2744;">
          <th style="<%= th_style %>">Name</th>
          <th style="<%= th_style %>">Phone</th>
          <th style="<%= th_style %>"></th>
        </tr>
      </thead>
      <tbody>
        <% @inactive_employees.each do |employee| %>
          <tr style="border-bottom: 1px solid #f0ebe3;">
            <td style="<%= td_style %>"><%= employee.name %></td>
            <td style="<%= td_style %>"><%= employee.phone %></td>
            <td style="<%= td_style %>; text-align: right;">
              <%= link_to "View", employee_path(employee), style: view_btn_style %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= link_to "New Employee", new_employee_path, style: "background-color: #1a2744; color: #fff; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 500;" %>

</div>

<% th_style = "color: #fff; font-size: 12px; font-weight: 600; padding: 12px 16px; text-align: left; letter-spacing: 0.05em;" %>
<% td_style = "font-size: 14px; padding: 12px 16px; color: #333;" %>
<% view_btn_style = "background-color: #1a2744; color: #fff; padding: 6px 14px; border-radius: 6px; text-decoration: none; font-size: 13px; font-weight: 500;" %>