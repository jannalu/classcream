<%= form_with model: employee, local: true do |f| %>
  <% if employee.errors.any? %>
    <div class="alert alert-danger">
      <p>Please review the problems below</p>
      <% employee.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :first_name, "First name", class: "form-label" %>
    <%= f.text_field :first_name, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :last_name, "Last name", class: "form-label" %>
    <%= f.text_field :last_name, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= label_tag :employee_ssn, "Ssn", class: "form-label" %>
    <%= f.text_field :ssn, id: "employee_ssn", class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :date_of_birth, "Date of birth", class: "form-label" %>
    <%= f.date_field :date_of_birth, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :phone, "Phone", class: "form-label" %>
    <%= f.text_field :phone, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :role, "Role", class: "form-label" %>
    <%= f.select :role, [["Employee", "employee"], ["Manager", "manager"], ["Admin", "admin"]], {}, class: "form-select" %>
  </div>
  <div class="mb-3">
    <%= f.label :username, "Username", class: "form-label" %>
    <%= f.text_field :username, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= label_tag :employee_password, "Password", class: "form-label" %>
    <%= f.password_field :password, id: "employee_password", class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= label_tag :employee_password_confirmation, "Password confirmation", class: "form-label" %>
    <%= f.password_field :password_confirmation, id: "employee_password_confirmation", class: "form-control" %>
  </div>
  <div class="mb-3 form-check">
    <%= f.check_box :active, class: "form-check-input" %>
    <%= f.label :active, class: "form-check-label" %>
  </div>
  <%= f.submit class: "btn btn-dark" %>
<% end %>