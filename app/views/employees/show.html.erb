<h2>Employee #<%= @employee.id %>: <%= @employee.proper_name %></h2>

<div class="row mt-3">
  <div class="col-md-6 d-flex flex-column gap-3">

    <div class="cc-card">
      <h5 class="border-bottom pb-2">Employee Overview</h5>
      <p><strong>Phone:</strong> <%= @employee.phone %></p>
      <p><strong>Date of Birth:</strong> <%= @employee.date_of_birth.strftime("%B %-d, %Y") %></p>
      <p><strong>Role:</strong> <%= @employee.role.capitalize %></p>
      <p><strong>Current Store:</strong> <%= @current_assignment&.store&.name || "None" %></p>
      <p><strong>Status:</strong> <%= @employee.active? ? "Active" : "Inactive" %></p>
    </div>

    <div class="cc-card">
      <h5 class="border-bottom pb-2">Assignment History</h5>
      <table class="table table-sm">
        <thead class="table-dark">
          <tr>
            <th>STORE</th>
            <th>LEVEL</th>
            <th>START</th>
            <th>END</th>
          </tr>
        </thead>
        <tbody>
          <% @other_assignments.each do |assignment| %>
            <tr>
              <td><%= assignment.store.name %></td>
              <td><%= assignment.pay_grade.level %></td>
              <td><%= assignment.start_date.strftime("%m/%d/%y") %></td>
              <td><%= assignment.end_date ? assignment.end_date.strftime("%m/%d/%y") : "Current" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  </div>

  <div class="col-md-6">
    <div class="cc-card">
      <%= react_component("EmployeeShow", { employeeId: @employee.id }) %>
    </div>
  </div>
</div>

<div class="mt-4 d-flex gap-2">
  <%= link_to "Display All", employees_path, class: "btn-cc-danger" %>
  <%= link_to "Edit #{@employee.proper_name}", edit_employee_path(@employee), class: "btn-cc" %>
  <%= link_to "Delete #{@employee.proper_name}", employee_path(@employee),
        method: :delete, data: { confirm: "Are you sure?" }, class: "btn-cc-danger" %>
</div>